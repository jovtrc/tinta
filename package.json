{
	"name": "tinta",
	"private": true,
	"description": "A private team wiki for WordPress: pages in a tree, written in the block editor.",
	"license": "GPL-2.0-or-later",
	"packageManager": "pnpm@11.0.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "wp-scripts build --blocks-manifest",
		"start": "wp-scripts start --blocks-manifest",
		"typecheck": "tsc",
		"lint:js": "wp-scripts lint-js src tests/e2e tests/screenshots",
		"lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
		"format": "wp-scripts format src tests/e2e",
		"wp-env": "wp-env",
		"wp-env:test": "wp-env --config=.wp-env.test.json",
		"test:php": "wp-env run cli --config=.wp-env.test.json --env-cwd=wp-content/plugins/tinta vendor/bin/phpunit",
		"test:php:multisite": "wp-env run cli --config=.wp-env.test.json --env-cwd=wp-content/plugins/tinta env WP_MULTISITE=1 vendor/bin/phpunit",
		"test:e2e": "wp-scripts test-playwright",
		"screenshots": "wp-scripts test-playwright --config playwright.screenshots.config.js",
		"playground": "wp-playground-cli server --port=9400 --wp=7.1 --php=8.2 --mount=.:/wordpress/wp-content/plugins/tinta --blueprint=tests/e2e/blueprint.json"
	},
	"prettier": "@wordpress/prettier-config",
	"devDependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@playwright/test": "^1.64.1",
		"@types/node": "^24.19.2",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@wordpress/a11y": "^5.0.0",
		"@wordpress/api-fetch": "^8.0.0",
		"@wordpress/block-editor": "^19.0.0",
		"@wordpress/block-library": "^12.0.0",
		"@wordpress/blocks": "^17.0.0",
		"@wordpress/commands": "^2.0.0",
		"@wordpress/components": "^43.0.0",
		"@wordpress/compose": "^9.0.0",
		"@wordpress/core-data": "^9.0.0",
		"@wordpress/data": "^11.0.0",
		"@wordpress/date": "^6.0.0",
		"@wordpress/e2e-test-utils-playwright": "^3.1.0",
		"@wordpress/editor": "^16.0.0",
		"@wordpress/element": "^10.0.0",
		"@wordpress/env": "^12.0.0",
		"@wordpress/escape-html": "^4.0.0",
		"@wordpress/format-library": "^6.0.0",
		"@wordpress/hooks": "^5.0.0",
		"@wordpress/html-entities": "^5.0.0",
		"@wordpress/i18n": "^7.0.0",
		"@wordpress/icons": "^19.0.0",
		"@wordpress/keycodes": "^5.0.0",
		"@wordpress/notices": "^6.0.0",
		"@wordpress/prettier-config": "^5.0.0",
		"@wordpress/scripts": "^37.0.0",
		"@wordpress/url": "^5.0.0",
		"@wp-playground/cli": "^3.1.62",
		"prettier": "npm:wp-prettier@^3.9.6",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"typescript": "^6.0.3"
	}
}
