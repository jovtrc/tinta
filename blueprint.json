{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Tinta – Team Wiki",
		"author": "jcarvalho",
		"description": "A private team wiki inside WordPress, with the latest release of Tinta installed."
	},
	"landingPage": "/wp-admin/admin.php?page=tinta",
	"preferredVersions": {
		"php": "8.2",
		"wp": "latest"
	},
	"steps": [
		{
			"step": "login"
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/jovtrc/tinta/releases/latest/download/tinta.zip"
			},
			"options": {
				"activate": true
			}
		}
	]
}
